#!/usr/bin/env bash
# clean-node-modules — find and remove node_modules under the current directory.
#
# Scans recursively from $PWD, lists every top-level node_modules it finds
# (skipping nested ones inside other node_modules), shows their sizes, then
# asks for a single confirmation before deleting.
#
# Usage:
#   clean-node-modules            # interactive
#   clean-node-modules -y         # skip prompt
#   clean-node-modules -n         # dry-run, just list
#   clean-node-modules -h         # help

set -uo pipefail

YES=0
DRY=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    -y|--yes)     YES=1 ;;
    -n|--dry-run) DRY=1 ;;
    -h|--help)
      sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    *)
      echo "Unknown argument: $1" >&2
      echo "Try: clean-node-modules -h" >&2
      exit 2
      ;;
  esac
  shift
done

ROOT="$(pwd)"

# -prune on a match: descend no further, so nested node_modules under another
# node_modules are excluded. Use -print0 for path safety.
mapfile -d '' DIRS < <(
  find "$ROOT" -type d -name node_modules -prune -print0 2>/dev/null
)

if [[ ${#DIRS[@]} -eq 0 ]]; then
  echo "No node_modules found under $ROOT"
  exit 0
fi

echo "Found ${#DIRS[@]} node_modules under $ROOT:"
echo

TOTAL_BYTES=0
for d in "${DIRS[@]}"; do
  # du -sk: size in 1K blocks, portable on macOS.
  SIZE_K="$(du -sk "$d" 2>/dev/null | awk '{print $1}')"
  SIZE_K="${SIZE_K:-0}"
  TOTAL_BYTES=$(( TOTAL_BYTES + SIZE_K * 1024 ))
  REL="${d#"$ROOT"/}"
  [[ "$REL" == "$d" ]] && REL="$d"
  printf "  %8s  %s\n" "$(du -sh "$d" 2>/dev/null | awk '{print $1}')" "$REL"
done

# Human-readable total.
human() {
  local b=$1
  if   (( b >= 1073741824 )); then awk -v b="$b" 'BEGIN{printf "%.2fG", b/1073741824}'
  elif (( b >= 1048576 ));    then awk -v b="$b" 'BEGIN{printf "%.2fM", b/1048576}'
  elif (( b >= 1024 ));       then awk -v b="$b" 'BEGIN{printf "%.2fK", b/1024}'
  else echo "${b}B"
  fi
}

echo
echo "Total: $(human "$TOTAL_BYTES")"

if (( DRY )); then
  echo "(dry-run — nothing removed)"
  exit 0
fi

if (( ! YES )); then
  echo
  read -r -p "Remove all ${#DIRS[@]} node_modules folder(s)? [y/N] " REPLY
  case "$REPLY" in
    y|Y|yes|YES) ;;
    *) echo "Aborted."; exit 0 ;;
  esac
fi

FAILED=0
for d in "${DIRS[@]}"; do
  if rm -rf -- "$d"; then
    echo "removed  $d"
  else
    echo "failed   $d" >&2
    FAILED=$(( FAILED + 1 ))
  fi
done

if (( FAILED )); then
  echo "Done with $FAILED failure(s)." >&2
  exit 1
fi

echo "Done. Reclaimed ~$(human "$TOTAL_BYTES")."
