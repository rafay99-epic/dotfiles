#!/bin/bash

source "$CONFIG_DIR/colors.sh" # Loads all defined colors

# This is a demo config to show some of the most important commands more easily.
# This is meant to be changed and configured, as it is intentionally kept sparse.
# For a more advanced configuration example see my dotfiles:
# https://github.com/FelixKratz/dotfiles

PLUGIN_DIR="$CONFIG_DIR/plugins"
ITEM_DIR="$CONFIG_DIR/items"

##### Bar Appearance #####
# Configuring the general appearance of the bar, these are only some of the
# options available. For all options see:
# https://felixkratz.github.io/SketchyBar/config/bar
# If you are looking for other colors, see the color picker:
# https://felixkratz.github.io/SketchyBar/config/tricks#color-picker

sketchybar --bar height=36           \
                 position=top        \
                 sticky=off          \
                 padding_left=10     \
                 padding_right=10    \
                 color=0x00000000    \
                 y_offset=0          \
                 margin=10

##### Changing Defaults #####
# We now change some default values that are applied to all further items
# For a full list of all available item properties see:
# https://felixkratz.github.io/SketchyBar/config/items

sketchybar --default icon.font="$FONT:Semibold:15.0"          \
                     icon.color=$WHITE                         \
                     label.font="$FONT:Semibold:13.0"          \
                     label.color=$WHITE                        \
                     background.drawing=off                    \
                     padding_left=4                            \
                     padding_right=4                           \
                     label.padding_left=4                      \
                     label.padding_right=8                     \
                     icon.padding_left=8                       \
                     icon.padding_right=4

# -- Left Side Items --
source $ITEM_DIR/spaces.sh
source $ITEM_DIR/front_app.sh

# -- Right Side Of Notch Items --
source $ITEM_DIR/media.sh

# -- Right Side Items --
source $ITEM_DIR/calendar.sh
source $ITEM_DIR/volume.sh
source $ITEM_DIR/battery.sh
source $ITEM_DIR/wifi.sh
source $ITEM_DIR/codexbar.sh


##### Notch-Aware Split Bar #####
# The main bar is transparent. Two bracket "pills" provide the visual background:
#   left_bar  — left side of the notch  (positions: left → q)
#   right_bar — right side of the notch (positions: e → right)
# Zero-width invisible anchors pin each end of the brackets to the screen edges.

sketchybar --add item left_anchor  left  --set left_anchor  width=0 \
           --add item q_anchor     q     --set q_anchor     width=0 \
           --add item e_anchor     e     --set e_anchor     width=0 \
           --add item right_anchor right --set right_anchor width=0

sketchybar --add bracket left_bar  left_anchor \
                                   space.1 space.2 space.3 space.4 space.5 \
                                   space.6 space.7 space.8 space.9 space.10 \
                                   space_separator front_app \
                                   q_anchor \
           --set left_bar background.color=0x881a1b26        \
                          background.corner_radius=12         \
                          background.blur_radius=20

sketchybar --add bracket right_bar e_anchor \
                                   media calendar volume battery wifi codexbar \
                                   right_anchor \
           --set right_bar background.color=0x881a1b26        \
                           background.corner_radius=12         \
                           background.blur_radius=20

##### Finalizing Setup #####
# The below command is only needed at the end of the initial configuration to
# force all scripts to run the first time, it should never be run in an item script.

sketchybar --update
