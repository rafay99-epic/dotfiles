<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  ============================================================================
  com.prometheus.sort-downloads — auto-sort ~/Downloads to NAS

  Watches ~/Downloads via launchd's WatchPaths and fires `sort-downloads`
  whenever a file is added, removed, or modified. The script classifies
  each file by extension/name (images, PDFs, docs, DMGs, etc.) and routes
  it to /Volumes/media/<Category>/.

  Screenshots are *not* handled here. macOS scopes SMB write access to
  the Aqua GUI session that mounted the share; launchd-spawned processes
  can read the share but cannot write to it for most operations. Configure
  your capture tool (e.g. Shottr) to save directly to
  /Volumes/media/screenshots/ instead.

  This is a LaunchAgent — not a LaunchDaemon — because it touches user-mounted
  resources (the SMB share at /Volumes/media). Daemons run as root before the
  user session and cannot see user mounts.

  __HOME__ is a placeholder. install.sh substitutes $HOME before writing this
  file into ~/Library/LaunchAgents/ — the source in the repo intentionally
  does not reference any user-specific path.

  Install (handled by install.sh):
    sed "s|__HOME__|$HOME|g" com.prometheus.sort-downloads.plist \
      > ~/Library/LaunchAgents/com.prometheus.sort-downloads.plist
    launchctl unload ~/Library/LaunchAgents/com.prometheus.sort-downloads.plist 2>/dev/null
    launchctl load   ~/Library/LaunchAgents/com.prometheus.sort-downloads.plist

  Uninstall:
    launchctl unload ~/Library/LaunchAgents/com.prometheus.sort-downloads.plist
    rm               ~/Library/LaunchAgents/com.prometheus.sort-downloads.plist

  Trigger immediately for testing:
    launchctl start com.prometheus.sort-downloads

  Logs:
    tail -f ~/.sort-download/sort-downloads.log
  ============================================================================
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.prometheus.sort-downloads</string>

    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/.local/bin/sort-downloads</string>
    </array>

    <!-- Fire whenever ~/Downloads changes. launchd coalesces rapid events. -->
    <key>WatchPaths</key>
    <array>
        <string>__HOME__/Downloads</string>
    </array>

    <!-- Debounce: at most one invocation every 30s. Also gives partial
         downloads time to finish; the script's own settle check filters
         anything still in flight. -->
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <!-- Sweep on login / first install so anything already in Downloads
         gets sorted on day one. -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Also fire whenever ANY volume mounts. The script already bails
         cleanly when /Volumes/media isn't mounted, so unrelated volumes
         (Time Machine drive, a USB stick, etc.) are no-ops. The case that
         matters: NAS reconnect after a network drop or fresh login —
         launchd's WatchPaths only re-fires on a fresh ~/Downloads change,
         so without this, files that arrived while the NAS was offline
         would sit there until the next download moved the directory's
         mtime. StartOnMount closes that gap. -->
    <key>StartOnMount</key>
    <true/>

    <!-- Safety net: sweep every 5 minutes no matter what. We learned the
         hard way that WatchPaths subscriptions go silently dead on macOS
         (verified empirically: agent loaded, watching=1 in launchctl print,
         directory mtime visibly changing on new downloads — and yet the
         agent never fires). Could be Sequoia's Background Activity
         throttling unsigned LaunchAgents, could be fsevents starvation,
         could be a launchd state-machine bug. Doesn't matter — the
         pragmatic fix is to poll. 300 s gives a worst-case 5 min lag,
         the script's no-op path is ~10 ms when Downloads is empty
         (just stats files, hits the lock, exits), and ThrottleInterval=30
         keeps WatchPaths bursts from compounding with this. -->
    <key>StartInterval</key>
    <integer>300</integer>

    <key>StandardOutPath</key>
    <string>__HOME__/.sort-download/sort-downloads.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.sort-download/sort-downloads.log</string>
</dict>
</plist>
