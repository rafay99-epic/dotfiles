# =============================================================================
# Prometheus Dotfiles — local config template
# =============================================================================
#
# DO NOT EDIT THIS FILE TO RUN THE DOTFILES.
#
# Instead, run `./install.sh` once and it'll write your real config to:
#
#     ~/.config/dotfiles/local.env
#
# This template is here so you can see every supported option in one place
# and grep for documentation. The real file is yours, lives outside this
# repo, and is never committed.
#
# To re-run the wizard later:    ./install.sh --reconfigure
# To inspect your current config: cat ~/.config/dotfiles/local.env
#
# Values are sourced into bash, so shell-quoting rules apply.
# =============================================================================


# ─ Code projects ────────────────────────────────────────────────────────────
#
# Where you keep your code. archive-project scans this directory recursively
# for git repos. Defaults to ~/Code if unset.

CODE_DIR="$HOME/Code"


# ─ Git identity ─────────────────────────────────────────────────────────────
#
# Written to ~/.gitconfig.local by the installer (the committed git/.gitconfig
# has an [include] hook that picks them up). Leave empty to skip — git will
# fall back to whatever's already in your global config.

GIT_USER_NAME=""
GIT_USER_EMAIL=""


# ─ NAS ──────────────────────────────────────────────────────────────────────
#
# Set HAS_NAS=true if you have a TrueNAS / Synology / generic SMB share that
# you want this machine to integrate with. When HAS_NAS=false:
#   - the .inetloc auto-mount login item is NOT installed
#   - sort-downloads + archive-project skip their pre-flight mount check
#   - the `media` shell alias is not created
#   - Time Machine to NAS is automatically off (see below)

HAS_NAS=false

# IP address or hostname. Resolved by macOS SMB stack at mount time.
NAS_HOST=""

# Your username on the NAS (the account that owns the share).
NAS_USER=""

# Share name for general file storage. Mounted at NAS_MOUNT_MEDIA. The
# share itself must exist on the NAS side; the installer can't create it
# for you.
NAS_SHARE_MEDIA="media"
NAS_MOUNT_MEDIA="/Volumes/media"


# ─ Time Machine on the NAS ──────────────────────────────────────────────────
#
# Only meaningful when HAS_NAS=true. When HAS_TIMEMACHINE_NAS=true:
#   - the tm-monthly LaunchDaemon is installed (root-owned, fires on the 1st
#     of each month at 03:00)
#   - `sudo tmutil disable` is run to replace Apple's hourly schedule
#   - tm-status and tm-backup helper scripts are symlinked to ~/.local/bin/

HAS_TIMEMACHINE_NAS=false

# A SEPARATE share from NAS_SHARE_MEDIA — Time Machine wants exclusive use.
NAS_SHARE_TM="timemachine"

# true  = replace Apple's hourly schedule with monthly-on-the-1st-at-03:00
# false = keep Apple's default (and just point it at the NAS share)
TM_SCHEDULE_MONTHLY=true


# ─ Auto-sort ~/Downloads onto the NAS ──────────────────────────────────────
#
# Only meaningful when HAS_NAS=true. When ENABLE_SORT_DOWNLOADS=true:
#   - bin/sort-downloads is symlinked to ~/.local/bin/
#   - if SORT_DOWNLOADS_BACKGROUND=true, the LaunchAgent is installed and
#     fires on every file appearing in ~/Downloads
#   - if SORT_DOWNLOADS_BACKGROUND=false, the script exists but nothing
#     fires it — run `sort-downloads` manually when you want a sweep

ENABLE_SORT_DOWNLOADS=false
SORT_DOWNLOADS_BACKGROUND=true


# ─ archive-project (manual cold-storage move to NAS) ───────────────────────
#
# Only meaningful when HAS_NAS=true. When ENABLE_ARCHIVE_PROJECT=true:
#   - bin/archive-project is symlinked to ~/.local/bin/
#   - man/archive-project.1 is reachable via `archive-project --man`
#
# Threshold: a project is a candidate when its last commit is older than
# ARCHIVE_AFTER_MONTHS months AND its working tree is clean. Override on
# a single run with `archive-project --months=N`.

ENABLE_ARCHIVE_PROJECT=false
ARCHIVE_AFTER_MONTHS=1
